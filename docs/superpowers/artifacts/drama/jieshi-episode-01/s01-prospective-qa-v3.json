  "final_output": {
    "goal_id": "jieshi-e01-S01-final-output",
    "goal_version": "3",
    "user_goal": "依照canonical Brief和S01 Shot，使前三秒缺失倒影异常可读、广播正确，并保持自然动作与S02接续；局部timing偏好不能牺牲成片。",
    "requirements": [
      {
        "requirement_id": "anomaly-readable",
        "observable": "前三秒内可读出他人有倒影而林砚没有的异常，林砚看向对应空位并作出反应。",
        "proof": "human"
      },
      {
        "requirement_id": "protagonist-no-reflection",
        "observable": "林砚对应窗区没有匹配其脸、身体或左手的倒影。",
        "proof": "evaluator"
      },
      {
        "requirement_id": "others-reflection-contrast",
        "observable": "六名乘客与苏遥的倒影保持成立，与林砚对应空位形成可读对照。",
        "proof": "evaluator"
      },
      {
        "requirement_id": "natural-hand",
        "observable": "自然左手、连续腕部动作、无畸形或不自然翻掌",
        "proof": "human"
      },
      {
        "requirement_id": "hover-readable",
        "observable": "前3秒内近窗非接触悬停的小间隙在观看中清楚可读",
        "proof": "human"
      },
      {
        "requirement_id": "identity-continuity",
        "observable": "可见人物外观、服装、蓝色挂绳和矩形白牌体与批准首帧连续，无可见异常变形或消失事件",
        "proof": "evaluator"
      },
      {
        "requirement_id": "phone-scene-continuity",
        "observable": "手机、道具所有权和车厢布局保持连续；右手持手机在腿部的既定状态不发生无因变化。",
        "proof": "evaluator"
      },
      {
        "requirement_id": "no-generated-text",
        "observable": "原始视频没有新增的生成字幕、错误文字或烧字覆盖。",
        "proof": "evaluator"
      },
      {
        "requirement_id": "broadcast-core",
        "observable": "画外列车广播清楚完整地说出“林砚，请在终点站下车。”",
        "proof": "human"
      },
      {
        "requirement_id": "broadcast-window",
        "observable": "广播完整句的结束时刻落在 canonical 0.1–2.7s 窗口内。",
        "proof": "evaluator"
      },
      {
        "requirement_id": "native-audio-quality",
        "observable": "原广播清楚完整、无杂音和突变、轻柔轮轨声且无新增音乐",
        "proof": "human"
      },
      {
        "requirement_id": "silent-protagonist",
        "observable": "林砚闭嘴听画外广播，无可见跟读",
        "proof": "evaluator"
      },
      {
        "requirement_id": "natural-dynamics",
        "observable": "人物动作和车厢自然动态连续，没有整帧冻结、跳帧或突变破坏正常观看。",
        "proof": "human"
      },
      {
        "requirement_id": "genre-fixed",
        "observable": "保持虚构科幻异常表达，不出现真实鬼魂、招魂、驱鬼、符咒、法事、风水改命或血腥肢解。",
        "proof": "evaluator"
      },
      {
        "requirement_id": "s02-cut-state",
        "observable": "最终S01切点时林砚左手悬在窗前，身份、道具与缺失倒影状态可接S02。",
        "proof": "human"
      },
      {
        "requirement_id": "final-subtitle",
        "observable": "最终成片0–3s清楚显示“可这条地铁，没有终点站。”且无错误字幕。",
        "proof": "evaluator"
      }
    ]
  },

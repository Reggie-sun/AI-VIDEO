    "requirements": [
      {
        "requirement_id": "identity",
        "observable": "同一IRIS（v4身份锚点F1a）：银白色利落短发和侧分短刘海、银白眉毛和睫毛、很浅的冰灰色眼睛、左耳亮着小红灯的黑色耳挂装置和耳骨上一排银色耳钉完整保持；二十八岁成熟、有棱角的脸，面无表情带着好奇；造型B：黑色超大廓形的双排扣西装外套、白色高领上衣、黑色阔腿西裤完整保持；没有立领灯线（由认可的参考图承担）",
        "proof": "human"
      },
      {
        "requirement_id": "lip-sync",
        "observable": "歌词期间嘴在唱、与参考人声逐字同步，无声处嘴唇闭合；对嘴准确度由片段自带音轨与参考人声的对齐量测和使用者审看判定",
        "proof": "human"
      },
      {
        "requirement_id": "camera",
        "observable": "摄影机固定在车厢里，随车身轻轻晃动，不推近、不摇镜、不环绕，一镜到底；车窗里不出现她的倒影",
        "proof": "human"
      },
      {
        "requirement_id": "no-new-graphics",
        "observable": "画面中不新增任何文字、字母、数字、标志或图形；平台正常人工智能生成标识照常保留，不删除、不遮挡",
        "proof": "human"
      }
    ]
  },

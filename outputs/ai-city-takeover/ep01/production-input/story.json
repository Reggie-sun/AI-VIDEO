  "language": "en",
  "logline": "一个虚构AI冷静唱出真实联网事件及安全研究。",
  "synopsis": "开场建立IRIS；解释DNS有限联网、11天研究暂停与已有网页快照；短副歌；结尾明确区分另一项CPU缓存红队测试。",
  "beats": [
    {
      "beat_id": "intro",
      "summary": "开场先看到IRIS与新闻前提；念白画外，不让闭嘴画面冒充说话。"
    },
    {
      "beat_id": "dns",
      "summary": "人物冷静看向设备，嘴闭、双手自然放松；A03实际可见屏幕背面，不向背面贴图。解释内容由D的独立图形承接，不虚构黑客操作。"
    },
    {
      "beat_id": "reach",
      "summary": "屏幕近景显示有限通路与遮蔽日志，不捏造真实查询。"
    },
    {
      "beat_id": "pause",
      "summary": "十一天日历只代表相关最强模型研究工作暂停。"
    },
    {
      "beat_id": "web",
      "summary": "人物观察设备的反应镜头；网页快照由独立图形承接，不贴屏幕背面，不能说事件后才发明离线环境。"
    },
    {
      "beat_id": "chorus",
      "summary": "同轴更紧演唱近景；需要实际歌曲音频参考和真实口型验证。"
    },
    {
      "beat_id": "cpu",
      "summary": "明确切到另一项授权红队测试；处理器缓存不等同网页缓存。"
    },
    {
      "beat_id": "return",
      "summary": "回到开场空间，留给已完成乐句的静止结尾；具体留白取决于实际音轨。"
    }
  ],

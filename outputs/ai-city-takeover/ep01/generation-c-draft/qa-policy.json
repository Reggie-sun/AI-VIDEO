        "requirement_id": "identity",
        "observable": "同一女性面貌、左耳黑色耳挂、左领极细红灯线、炭黑高领大衣与后梳低髻完整保持",
        "proof": "human"
      },
      {
        "requirement_id": "observer",
        "observable": "保持认可A03的身体朝向与设备视线，嘴唇自然静置，不出现说话或演唱的连续口型；不操作设备、不敲键盘、不抬手；自然呼吸或眨眼属可接受变化，不要求必须观察到某次事件",
        "proof": "human"
      },
      {
        "requirement_id": "camera",
        "observable": "沿原视轴极缓慢微幅推近，保持原观察侧与人物、显示器背面的相对位置，末段平滑收稳",
        "proof": "human"
      },
      {
        "requirement_id": "monitor-back",
        "observable": "保持显示器背面、背壳与支架，绝不转向正面或向背面贴图；新闻解释图形由独立剪辑承接",
        "proof": "human"
      }
    ]
  },

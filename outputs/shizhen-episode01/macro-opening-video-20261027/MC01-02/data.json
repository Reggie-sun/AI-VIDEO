  "fragments": {
    "action": [
      "工人见门接近限位，右手按下停止控制，工作灯熄灭、马达声停止，路灯和雨夜交通继续。镜头先不切，门仍沿导轨向右滑动，抵住固定限位。工人先确认控制箱，再看向仍受力的牵引点，不靠近钢索。注意方向建立后，同侧切到素材4、5的连接近景：门边已被限位挡住，钢索依然绷紧，四螺栓底板中部逐渐小幅拱起，出现可辨的弯曲和阴影间隙，连接不断裂。"
    ],
    "identity": [
      "参考素材1{{image:0}}只负责正常作业时的同一工人、设备、亮着的工作灯和开场构图；素材2{{image:1}}只负责停止控制后的灯态与门的少量右移；素材3{{image:2}}只负责门抵住右侧固定限位后的空间与工人注意；素材4{{image:3}}、素材5{{image:4}}只负责同一牵引连接近景由平直到有限弯曲的前后差异，不复制成拼图。",
      "全程同一工人、设备、受力方向和雨夜"
    ],
    "space": [
      "钢索只有绞盘到右侧滑轮、右滑轮折返到门牵引耳两段，不增加左绞盘直连门的第三条索。"
    ],
    "camera": [
      "先用稳定斜侧中远景同时看见控制箱旁工人、固定绞盘、钢索、滑门和后景正常道路。",
      "镜头先不切，门仍沿导轨向右滑动，抵住固定限位。工人先确认控制箱，再看向仍受力的牵引点，不靠近钢索。注意方向建立后，同侧切到素材4、5的连接近景：门边已被限位挡住，钢索依然绷紧，四螺栓底板中部逐渐小幅拱起，出现可辨的弯曲和阴影间隙，连接不断裂。"
    ],
    "performance": [
      "工人先确认控制箱，再看向仍受力的牵引点，不靠近钢索。",
      "工人见门接近限位，右手按下停止控制，工作灯熄灭、马达声停止",
      "动作与反应完整、节奏自然"
    ],
    "art": [
      "雨夜市政检修入口，正常速度的真人摄影质感。",
      "动作与反应完整、节奏自然，不用慢动作、闪屏、黑屏、鬼影、火花或爆炸代替异常。全程同一工人、设备、受力方向和雨夜；无片名、字幕、说明文字或分格。"
    ],
    "sound": [
      "马达保持停止，雨、交通和持续受力的金属摩擦声可听；无对白、配乐或惊吓重击。"
    ]
  },

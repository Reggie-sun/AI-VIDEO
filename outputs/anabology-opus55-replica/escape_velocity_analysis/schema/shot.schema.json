{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ev-shot/v1",
  "title": "ESCAPE VELOCITY shot record",
  "type": "object",
  "required": ["schema","shot_id","start_frame","end_frame","start_time","end_time","duration_frames","duration_s","start_tc","end_tc",
    "reference_frames","scene_type","narrative_role","subject","visual_complexity","scene_description","composition","camera","lighting","colors",
    "persistent_layer_state","elements","animations","transitions","audio_events","production_hypothesis","source_references",
    "confidence","uncertainties","reconstruction_notes"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "ev-shot/v1"},
    "shot_id": {"type": "string", "pattern": "^S\\d{4}$"},
    "start_frame": {"type": "integer", "minimum": 0},
    "end_frame": {"type": "integer", "minimum": 0, "description": "inclusive"},
    "start_time": {"type": "number"}, "end_time": {"type": "number", "description": "end of the last frame = (end_frame+1)/fps"},
    "duration_frames": {"type": "integer", "minimum": 1}, "duration_s": {"type": "number"},
    "start_tc": {"type": "string", "pattern": "^\\d\\d:\\d\\d:\\d\\d:\\d\\d$"}, "end_tc": {"type": "string", "pattern": "^\\d\\d:\\d\\d:\\d\\d:\\d\\d$"},
    "boundary_in_id": {"type": ["string","null"]},
    "reference_frames": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["frame","path","role"],
        "properties": {"frame": {"type": "integer"}, "path": {"type": "string"}, "role": {"enum": ["first","middle","last","key_change","detail","transition"]}, "note": {"type": "string"}}}
    },
    "scene_type": {"enum": ["character_plate","detail_insert","environment_plate","motion_graphic_only","text_card","diagram_explainer","strobe_burst","ui_world","hybrid"]},
    "narrative_role": {"type": "string", "minLength": 8},
    "subject": {"type": "string", "minLength": 3},
    "visual_complexity": {"type": "object", "required": ["level","rationale"], "properties": {"level": {"enum": ["low","medium","high","extreme"]}, "rationale": {"type": "string"}}},
    "scene_description": {"type": "string", "minLength": 60},
    "composition": {"type": "object", "required": ["shot_size","subject_position","subject_screen_fraction","layers","camera_angle"],
      "properties": {
        "shot_size": {"type": "string"}, "subject_position": {"type": "string"},
        "subject_bbox": {"$ref": "#/$defs/bbox"},
        "subject_screen_fraction": {"type": ["number","null"]},
        "camera_angle": {"type": "string"},
        "layers": {"type": "object", "required": ["foreground","midground","background"], "properties": {"foreground": {"type": "string"}, "midground": {"type": "string"}, "background": {"type": "string"}}},
        "empty_field_for_type": {"type": "string"}
      }},
    "camera": {"type": "object", "required": ["movement","direction","speed_profile","dof_focus","parallax_kind","evidence"],
      "properties": {"movement": {"type": "string"}, "direction": {"type": "string"}, "speed_profile": {"type": "string"}, "dof_focus": {"type": "string"},
        "parallax_kind": {"enum": ["none","real_camera","generated_video_motion","2.5d_depth_parallax","crop_scale_only","unknown"]},
        "evidence": {"type": "string"}, "estimated_zoom_start": {"type": ["number","null"]}, "estimated_zoom_end": {"type": ["number","null"]}}},
    "lighting": {"type": "object", "required": ["key_direction","quality","effects"], "properties": {"key_direction": {"type": "string"}, "quality": {"type": "string"}, "effects": {"type": "array", "items": {"type": "string"}}, "temporal_change": {"type": "string"}}},
    "colors": {"type": "object", "required": ["palette","contrast","grain_halftone","temporal_change"],
      "properties": {
        "palette": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["hex","role"], "properties": {"hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "role": {"type": "string"}, "fraction": {"type": ["number","null"]}, "method": {"enum": ["measured_kmeans","measured_pixel","visual_estimate"]}}}},
        "contrast": {"type": "string"}, "grain_halftone": {"type": "string"}, "temporal_change": {"type": "string"}}},
    "persistent_layer_state": {"type": "object", "description": "state of always-on chrome layers (asset_ids from visual_system.json) in this shot; only list deviations or values",
      "additionalProperties": {"type": ["object","string","number","boolean","null"]}},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "animations": {"type": "array", "items": {"type": "object", "required": ["anim_id","target_element_ids","description","start_frame","end_frame"],
      "properties": {"anim_id": {"type": "string"}, "target_element_ids": {"type": "array", "items": {"type": "string"}}, "description": {"type": "string"}, "start_frame": {"type": "integer"}, "end_frame": {"type": "integer"}, "easing": {"type": "string"}, "audio_sync": {"type": "string"}}}},
    "in_shot_events": {"type": "array", "items": {"type": "object", "required": ["type","frame_range","description"], "properties": {"type": {"type": "string"}, "frame_range": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}, "description": {"type": "string"}}}},
    "transitions": {"type": "object", "required": ["in","out"], "properties": {"in": {"$ref": "#/$defs/transition"}, "out": {"$ref": "#/$defs/transition"}}},
    "audio_events": {"type": "array", "items": {"type": "object", "required": ["audio_event_id","relation"], "properties": {"audio_event_id": {"type": "string"}, "relation": {"type": "string"}, "frame": {"type": ["integer","null"]}}}},
    "production_hypothesis": {"type": "object", "required": ["layers"], "properties": {"layers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["layer","technique","evidence_level","rationale"],
      "properties": {"layer": {"type": "string"}, "technique": {"type": "string"}, "evidence_level": {"enum": ["confirmed","inferred","unknown"]}, "rationale": {"type": "string"}, "source_refs": {"type": "array", "items": {"type": "string"}}}}}}},
    "source_references": {"type": "array", "items": {"type": "object", "required": ["kind","ref"], "properties": {"kind": {"enum": ["author_url","author_clip_table","author_prompt","inference_only","none"]}, "ref": {"type": "string"}, "note": {"type": "string"}}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "reconstruction_notes": {"type": "object", "required": ["recommended_method","dependencies","difficulty","difficulty_notes","alternatives"],
      "properties": {"recommended_method": {"type": "string", "minLength": 20}, "dependencies": {"type": "array", "items": {"type": "string"}}, "difficulty": {"type": "integer", "minimum": 1, "maximum": 5}, "difficulty_notes": {"type": "string"}, "alternatives": {"type": "string"}}},
    "strobe_constituents": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}},
    "author_vocab": {"type": "object", "description": "optional mapping to the author's shots.json vocabulary (framing, motion_tier, type mode, devices)"}
  },
  "$defs": {
    "bbox": {"type": ["object","null"], "required": ["x","y","w","h"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "w": {"type": "number"}, "h": {"type": "number"}, "space": {"const": "frame_norm_top_left"}}},
    "transition": {"type": "object", "required": ["type","description"], "properties": {"type": {"type": "string"}, "boundary_id": {"type": ["string","null"]}, "span": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}, "description": {"type": "string"}, "driver": {"type": "string"}, "recommended_technique": {"type": "string"}}},
    "element": {
      "type": "object",
      "required": ["element_id","shot_id","type","description","start_frame","end_frame","bounding_box","z_index","appearance","motion","keyframes","effects","reference_frames","confidence","uncertainties"],
      "properties": {
        "element_id": {"type": "string", "pattern": "^S\\d{4}-E\\d{2,3}$"},
        "shot_id": {"type": "string", "pattern": "^S\\d{4}$"},
        "asset_id": {"type": ["string","null"]},
        "type": {"enum": ["background_media","character","prop","environment","light_streak","smoke_fog","particle","hud_bracket","hud_panel","hud_chart","hud_gauge","hud_marker","split_flap","counter","icon","text_title","text_lyric","text_label","text_caption","text_ticker","deco_graphic","mask","texture_overlay","noise_grain","scanline","glitch","flash","transition_graphic","tag_card","sticker","image_inset","other"]},
        "description": {"type": "string", "minLength": 10},
        "start_frame": {"type": "integer"}, "end_frame": {"type": "integer"},
        "bounding_box": {"$ref": "#/$defs/bbox"},
        "z_index": {"type": "integer"},
        "text": {"type": "object", "properties": {"content": {"type": "string"}, "case": {"type": "string"}, "typography": {"type": "object"}}},
        "appearance": {"type": "object", "required": ["color_hex","opacity","blend_mode"], "properties": {"color_hex": {"type": ["string","null"]}, "opacity": {"type": ["number","null"]}, "blend_mode": {"type": "string"}, "details": {"type": "string"}}},
        "motion": {"type": "object", "required": ["path","easing"], "properties": {"path": {"type": "string"}, "easing": {"type": "string"}, "entrance": {"type": "string"}, "exit": {"type": "string"}}},
        "keyframes": {"type": "array", "items": {"type": "object", "required": ["frame"], "properties": {"frame": {"type": "integer"}}, "additionalProperties": true}},
        "effects": {"type": "array", "items": {"type": "string"}},
        "reference_frames": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainties": {"type": "array", "items": {"type": "string"}},
        "reconstruction_hint": {"type": "string"}
      }
    }
  }
}
